# FlowForge environment configuration.
# Copy to .env (or run `python scripts/devstack.py init-env`, which also generates the secrets marked __GENERATE__).
# Never commit .env. Every FLOWFORGE_* variable maps to a field in packages/core/src/flowforge_core/config.py.

# ---------------------------------------------------------------- general
FLOWFORGE_ENVIRONMENT=development
FLOWFORGE_LOG_LEVEL=INFO
FLOWFORGE_LOG_JSON=true

# ---------------------------------------------------------------- PostgreSQL (also used by docker compose)
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=flowforge
# Native development connects to localhost; docker compose overrides the host to `postgres`.
FLOWFORGE_DATABASE_URL=postgresql+asyncpg://flowforge:${POSTGRES_PASSWORD}@127.0.0.1:5432/flowforge
# Per process. A worker needs at least its concurrency + 2 (one per slot, plus heartbeat and log flush); a smaller
# pool keeps opening and closing connections under load, and the worker warns about it at start-up.
FLOWFORGE_DATABASE_POOL_SIZE=10

# ---------------------------------------------------------------- Redis
# Use 127.0.0.1, not localhost: on Windows `localhost` resolves to ::1 first and port relays that only listen on
# IPv4 (e.g. WSL) make every new connection wait ~2 s for the IPv6 attempt to time out.
FLOWFORGE_REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------- security
# HS256 signing key for access tokens; at least 32 characters. Rotate by deploying a new value (logs everyone out).
FLOWFORGE_JWT_SECRET=__GENERATE__
FLOWFORGE_ACCESS_TOKEN_TTL_SECONDS=900
FLOWFORGE_REFRESH_TOKEN_TTL_SECONDS=1209600
# Secure cookies require HTTPS, except on http://localhost which browsers treat as a secure context.
FLOWFORGE_COOKIE_SECURE=true
FLOWFORGE_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FLOWFORGE_ALLOW_REGISTRATION=true
# This email becomes a platform admin on registration (may drain shared workers).
FLOWFORGE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FLOWFORGE_RATE_LIMIT_PER_MINUTE=1200
FLOWFORGE_AUTH_RATE_LIMIT_PER_MINUTE=30
# Optional bearer token required by GET /metrics (leave empty to rely on network isolation instead).
FLOWFORGE_METRICS_TOKEN=
# Reverse proxies in front of the API that append X-Forwarded-For (docker compose sets 1 for nginx).
FLOWFORGE_TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------- worker
FLOWFORGE_WORKER_QUEUES=default,reports
FLOWFORGE_WORKER_CONCURRENCY=8
FLOWFORGE_WORKER_CPU_PROCESSES=2
FLOWFORGE_LEASE_TTL_SECONDS=30

# ---------------------------------------------------------------- control plane
FLOWFORGE_RETENTION_DAYS=30

# ---------------------------------------------------------------- observability
# e.g. http://localhost:4318 to export traces via OTLP/HTTP (Jaeger, Tempo, an OTel collector, ...)
FLOWFORGE_OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- web dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- docker compose
# Host port for the nginx entry point (dashboard + API).
FLOWFORGE_HTTP_PORT=8080

# ---------------------------------------------------------------- grafana (docker compose)
GRAFANA_ADMIN_PASSWORD=__GENERATE__
